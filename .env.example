# --- routing -------------------------------------------------------------------
# TypeSafe System One (Jev). Without it, routing uses the keyword fallback.
TYPESAFE_API_KEY=
# Any wire-compatible System One server works too (e.g. a self-hosted OpenJev).
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# JEV_DEADLINE_MS=900

# --- harness credentials (forwarded only to the harness that uses them) ----------
ANTHROPIC_API_KEY=        # Claude Code (or CLAUDE_CODE_OAUTH_TOKEN)
OPENAI_API_KEY=           # Codex (API key: gpt-6-* models)
# Codex with a ChatGPT subscription instead (gpt-5.6-* and gpt-6-astra). Use a dedicated login
# so token refreshes inside sandboxes can't invalidate your everyday one:
#   CODEX_HOME=~/.codex-relaywise codex login
# CODEX_AUTH_FILE=~/.codex-relaywise/auth.json   (compose: mount it, see README)
OPENROUTER_API_KEY=       # OpenCode and Hermes

# --- gateway -----------------------------------------------------------------------
# Comma-separated bearer tokens clients must send. Empty = unauthenticated (dev only).
RELAYWISE_API_KEYS=
# docker (default, one container per session) | local (host processes, dev only)
# RELAYWISE_EXECUTOR=docker
# RELAYWISE_CONTAINER_NETWORK=bridge
# RELAYWISE_CONTAINER_CPUS=2
# RELAYWISE_CONTAINER_MEMORY=4g
# RELAYWISE_RUN_TIMEOUT_MS=1800000
# RELAYWISE_CONTAINER_IDLE_MS=600000
# RELAYWISE_SESSION_RETENTION_MS=86400000
# RELAYWISE_CATALOG=./catalog.json
# RELAYWISE_ENABLE_MOCK=1
