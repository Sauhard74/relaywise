{
  "name": "relaywise",
  "private": true,
  "version": "0.1.0",
  "description": "One API for agent harnesses (Claude Code, Codex, OpenCode, Hermes) with Jev picking the right harness \u00d7 model \u00d7 effort per task.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/gateway/src/main.ts",
    "start": "tsx apps/gateway/src/main.ts",
    "build:agentd": "pnpm --filter @relaywise/agentd build",
    "build:image": "docker build -t relaywise/agent-runtime:latest -f docker/agent-runtime/Dockerfile .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:router": "tsx packages/router/eval/run.ts",
    "build:cli": "pnpm --filter relaywise --fail-if-no-match build",
    "relay": "node apps/cli/dist/relay.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
